IMG_NAME='PHOTOFRAME'
RELEASE=bookworm
export PHOTOFRAME_BRANCH=clean_ex_display_upgrade
ENABLE_SSH=1
FIRST_USER_NAME=photoframe
FIRST_USER_PASS=photoframe

# Build target: 'lite' (default) or 'desktop'.
#
#   lite    -> Raspberry Pi OS Lite + photoframe. The framebuffer is
#              owned by photoframe end-to-end; getty@tty1 is disabled
#              and plymouth-start is masked. Smallest image (~810 MB),
#              fastest build, the appliance default.
#
#   desktop -> Raspberry Pi OS Desktop (stage4) + photoframe. lightdm
#              is installed, but frame.service is ordered After=lightdm
#              and modules/display.py stops lightdm at frame startup
#              so the photoframe still owns the screen by default. The
#              desktop is reachable as a fallback by stopping
#              frame.service. getty@tty1 stays enabled (recovery VT)
#              and plymouth-start stays unmasked (boot splash). Larger
#              image (~1.7 GB Desktop + ~810 MB Lite byproduct from
#              stage2's EXPORT_IMAGE), longer build (~80-100 min).
#
# Must be `export`ed (see HISTORY bug #2: subshells inherit only the
# environment, not shell-locals from sourced config files).
export PHOTOFRAME_TARGET="${PHOTOFRAME_TARGET:-lite}"

case "${PHOTOFRAME_TARGET}" in
  lite)
    STAGE_LIST="stage0 stage1 stage2"
    ;;
  desktop)
    STAGE_LIST="stage0 stage1 stage2 stage3 stage4"
    ;;
  *)
    echo "config: invalid PHOTOFRAME_TARGET='${PHOTOFRAME_TARGET}' (expected 'lite' or 'desktop')" >&2
    exit 1
    ;;
esac
export STAGE_LIST

# Do not run the piwiz first-boot rename wizard; we ship a pre-set user.
DISABLE_FIRST_BOOT_USER_RENAME=1

# WiFi regulatory domain. Required: without this, stage2/02-net-tweaks
# leaves wpa_supplicant.conf without a country= line and the radio stays
# rfkill-blocked on first boot.
#
# PROJECT DECISION: the shipped default is US. This is a deliberate choice
# at this point in the project's life, not a universal recommendation. The
# maintainers are US-based and this matches the bench test environment.
# Users outside the US building their own images should change this to
# their ISO 3166-1 alpha-2 country code (GB, DE, CA, JP, ...).
# Non-US users running the pre-built release image can override the WiFi
# country at runtime via the COUNTRY field in /boot/firmware/wifi-config.txt.
#
# If multi-region support becomes a recurring feature request we will
# revisit and find a way to ship a region-neutral default (e.g. "00" plus
# a more prominent prompt for the user to set their own). For now, US.
WPA_COUNTRY=US

# Stage selection is driven by PHOTOFRAME_TARGET above (which sets
# STAGE_LIST). Stage5 (Full image with LibreOffice etc.) is permanently
# off via committed SKIP / SKIP_IMAGES marker files in stage5/, never
# wanted for any photoframe target. Stage3 / stage4 SKIPs were removed
# in the desktop-target work so that PHOTOFRAME_TARGET=desktop can
# reach them via STAGE_LIST.
